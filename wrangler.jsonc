{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "afr-claude-skills",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  // Solo archivos estáticos.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "pedrogomez.dev/proyecto/skills", "zone_name": "pedrogomez.dev" },
    { "pattern": "pedrogomez.dev/proyecto/skills/*", "zone_name": "pedrogomez.dev" },
    { "pattern": "www.pedrogomez.dev/proyecto/skills", "zone_name": "pedrogomez.dev" },
    { "pattern": "www.pedrogomez.dev/proyecto/skills/*", "zone_name": "pedrogomez.dev" }
  ]
}
